# ==============================================================================
# CORE REPOSITORIES (TAPS)
# ==============================================================================
# Tells Homebrew to look inside AWS's official repository for specialized cloud tools
tap "aws/tap"

# Adds support for managing background utilities (like databases) so they start automatically
tap "homebrew/services"

# ==============================================================================
# ESSENTIAL FOUNDATIONS
# ==============================================================================
# The industry standard version control tool for managing code repositories
brew "git"

# GitHub Command Line tool used to log in, fork, and manage repos from the terminal
brew "gh"                  

# Terminal multiplexer to split your screen into panes and preserve terminal sessions
brew "tmux"

# Modern, blazing-fast Vim-based code editor configured with Lua
brew "neovim"

# High-speed search tool that Neovim uses to instantly find text across your projects
brew "ripgrep"

# Utility that automatically loads and unloads hidden project environment variables (.env files)
brew "direnv"              

# ==============================================================================
# PRIMARY LANGUAGE RUNTIMES
# ==============================================================================
# JavaScript runtime engine required to execute npm scripts and run Vite/React projects
brew "node"

# Go (Golang) programming language runtime used for backend development
brew "go"

# ==============================================================================
# ESSENTIAL DATABASES & DATA UTILITIES
# ==============================================================================
# Ultra-fast, lightweight SQL database designed for high-performance analytical queries
brew "duckdb"              

# Minimal core driver utilities required to connect terminal apps to PostgreSQL databases
brew "libpq"               

